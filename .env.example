# Szablon konfiguracji. Skopiuj do .env i uzupełnij:  cp .env.example .env
# Plik .env jest w .gitignore — NIGDY go nie commituj.

# --- AI (Groq, opcjonalne) ---
# Bez klucza aplikacja działa w trybie formularza ("AI niedostępne").
# Klucz: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Transitous (MOTIS 2) ---
TRANSITOUS_BASE_URL=https://api.transitous.org
# Kontakt trafia do nagłówka User-Agent (wymóg zasad korzystania z Transitous).
# Wymagany do zapytań o połączenia — wpisz swój e-mail lub URL repozytorium.
APP_CONTACT=

# --- Baza danych (opcjonalne) ---
# Domyślnie: trip_planner.db w katalogu głównym repo (ścieżka absolutna).
# Ścieżka względna (sqlite:///./...) zależałaby od katalogu uruchomienia serwera.
# DATABASE_URL=sqlite:////pelna/sciezka/do/trip_planner.db

# --- CORS (frontend Vite) ---
CORS_ORIGINS=http://localhost:5173
